---
import { SITE_TITLE, SITE_TAGLINE, CATEGORIES } from '../consts';
const path = Astro.url.pathname;
const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---
<header class="masthead">
  <div class="ticker">
    <div class="wrap ticker-inner">
      <span>{today}</span>
      <span class="ticker-msg">Unofficial · Unaffiliated · Unbearably hopeful</span>
    </div>
  </div>
  <div class="wrap brand">
    <a href="/" class="logo" aria-label={`${SITE_TITLE} home`}>
      <span class="logo-mark" aria-hidden="true">TP</span>
      <span class="logo-text">
        <span class="logo-title">{SITE_TITLE}</span>
        <span class="logo-tag">{SITE_TAGLINE}</span>
      </span>
    </a>
  </div>
  <nav class="nav" aria-label="Main">
    <div class="wrap nav-inner">
      <a href="/" class:list={{ active: path === '/' }}>Home</a>
      {Object.entries(CATEGORIES).map(([key, c]) => (
        <a href={`/category/${key}/`} class:list={{ active: path.startsWith(`/category/${key}`) }}>{c.label}</a>
      ))}
      <a href="/archive/" class:list={{ active: path.startsWith('/archive') }}>Archive</a>
      <a href="/about/" class:list={{ active: path.startsWith('/about') }}>About</a>
    </div>
  </nav>
</header>

<style>
  .ticker { background: #000; color: #ddd; font-family: var(--font-head); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .ticker-inner { display: flex; justify-content: space-between; gap: 1rem; padding-top: 6px; padding-bottom: 6px; }
  .ticker-msg { color: var(--gold); }
  .brand { padding-top: 1.75rem; padding-bottom: 1.5rem; }
  .logo { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
  .logo-mark {
    flex: none;
    display: grid; place-items: center;
    width: 64px; height: 64px;
    background: var(--red); color: var(--gold);
    font-family: var(--font-head); font-weight: 700; font-size: 1.6rem;
    border: 3px solid var(--gold);
    clip-path: polygon(0 0, 100% 0, 100% 72%, 50% 100%, 0 72%);
  }
  .logo-text { display: flex; flex-direction: column; }
  .logo-title { font-family: var(--font-head); font-weight: 700; font-size: clamp(1.8rem, 6vw, 3.2rem); text-transform: uppercase; line-height: 1; }
  .logo-tag { color: var(--muted); font-style: italic; font-size: 0.98rem; margin-top: 0.35rem; }
  .nav { background: var(--red); border-top: 4px solid var(--gold); position: sticky; top: 0; z-index: 10; }
  .nav-inner { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; }
  .nav a {
    color: #fff; text-decoration: none; white-space: nowrap;
    font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.92rem;
    padding: 0.8rem 0.85rem;
  }
  .nav a:hover, .nav a.active { background: var(--red-dark); box-shadow: inset 0 -4px 0 var(--gold); }
  @media (max-width: 600px) { .ticker-msg { display: none; } .logo-mark { width: 48px; height: 48px; font-size: 1.2rem; } }
</style>
