---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PainMeter from '../../components/PainMeter.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib';
import { CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], related: posts.filter((p) => p !== post && p.data.category === post.data.category).slice(0, 2) },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post; related: Post[] }
const { post, newer, older, related } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, category, tags, mood, score } = post.data;
---
<BaseLayout title={title} description={description}>
  <div class="layout">
    <article>
      <header class="post-head">
        <a class="kicker" href={`/category/${category}/`}>{CATEGORIES[category].label}</a>
        <h1>{title}</h1>
        <p class="standfirst">{description}</p>
        {score && <div class="scoreline">{score}</div>}
        <div class="byline meta">
          By {author} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && ` · Updated ${formatDate(updatedDate)}`}
          {` · ${readingTime(post.body)} min read`}
        </div>
        <PainMeter mood={mood} />
      </header>

      <div class="prose"><Content /></div>

      {tags.length > 0 && (
        <ul class="tags">{tags.map((t) => <li>#{t}</li>)}</ul>
      )}

      <nav class="pager" aria-label="More posts">
        {older ? <a href={`/posts/${older.id}/`}><span class="meta">← Older</span>{older.data.title}</a> : <span />}
        {newer && <a class="right" href={`/posts/${newer.id}/`}><span class="meta">Newer →</span>{newer.data.title}</a>}
      </nav>

      {related.length > 0 && (
        <section>
          <h2 class="section-title">More {CATEGORIES[category].label}</h2>
          <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
        </section>
      )}
    </article>
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; margin-top: 2.25rem; }
  .post-head { border-bottom: 3px solid var(--red); padding-bottom: 1.25rem; margin-bottom: 1.75rem; display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0.25rem 0 0; }
  .standfirst { font-size: 1.25rem; font-style: italic; color: var(--muted); margin: 0; }
  .scoreline { font-family: var(--font-head); text-transform: uppercase; font-weight: 700; font-size: 1.5rem; background: #000; color: var(--gold); padding: 0.35rem 1rem; border-left: 6px solid var(--red); }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2rem 0; }
  .tags li { font-family: var(--font-head); font-size: 0.8rem; letter-spacing: 0.05em; border: 1px solid var(--line); padding: 0.2rem 0.6rem; color: var(--muted); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
  .pager a { display: flex; flex-direction: column; gap: 0.2rem; text-decoration: none; font-weight: 600; padding: 1rem; border: 1px solid var(--line); background: var(--card); }
  .pager a:hover { border-color: var(--red); }
  .pager .right { text-align: right; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .right { text-align: left; } }
</style>
