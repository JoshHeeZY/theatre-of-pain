---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, type Post } from '../../lib';
import { CATEGORIES, type CategoryKey } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (Object.keys(CATEGORIES) as CategoryKey[]).map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

interface Props { category: CategoryKey; posts: Post[] }
const { category, posts } = Astro.props;
const { label, blurb } = CATEGORIES[category];
---
<BaseLayout title={label} description={blurb}>
  <header class="page-head">
    <h1>{label}</h1>
    <p>{blurb}</p>
  </header>
  {posts.length ? (
    <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
  ) : (
    <p class="empty">Nothing here yet. Much like the trophy cabinet some seasons.</p>
  )}
</BaseLayout>

<style>
  .page-head { margin: 2.5rem 0 2rem; border-bottom: 3px solid var(--red); padding-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0; }
  .page-head p { font-style: italic; color: var(--muted); margin: 0.4rem 0 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .empty { color: var(--muted); font-style: italic; }
</style>
